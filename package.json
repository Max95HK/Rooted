{
  "name": "rooted",
  "version": "1.0.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.3",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:fe": "bun --filter @rooted/frontend dev",
    "dev:be": "bun --filter @rooted/backend dev",
    "add:fe": "bun add --cwd packages/frontend",
    "add:be": "bun add --cwd packages/backend"
  }
}